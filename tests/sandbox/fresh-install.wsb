<Configuration>
  <!--
    SCENARIO: Fresh Install
    Tests: Python + Git auto-install via winget, venv setup, pip, Instagram auth, scheduler.
    The sandbox has neither Python nor Git by default - winget will be offered for both.
  -->
  <Networking>Enable</Networking>

  <MappedFolders>
    <!-- HostFolder is relative to this .wsb file: tests\sandbox\ -> up two levels = repo root -->
    <MappedFolder>
      <HostFolder>..\..\</HostFolder>
      <SandboxFolder>C:\host-repo</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>

  <LogonCommand>
    <Command>powershell.exe -ExecutionPolicy Bypass -File "C:\host-repo\tests\sandbox\_bootstrap.ps1" -Scenario fresh</Command>
  </LogonCommand>
</Configuration>
